<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RaidDebrief.Core\RaidDebrief.Core.csproj" />
    <ProjectReference Include="..\..\src\RaidDebrief.UI\RaidDebrief.UI.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <RecordedFixtureDirectory>$(MSBuildThisFileDirectory)..\..\testdata\recorded\</RecordedFixtureDirectory>
    <P10SFixture>$(RecordedFixtureDirectory)P10S.json</P10SFixture>
    <HasRecordedFixtures Condition="Exists('$(P10SFixture)')">true</HasRecordedFixtures>
    <DefineConstants Condition="'$(HasRecordedFixtures)' == 'true'">$(DefineConstants);RECORDED_FIXTURES</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HasRecordedFixtures)' == 'true'">
    <None Include="$(P10SFixture)"
          Link="testdata\recorded\P10S.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WarnAboutMissingRecordedFixtures" BeforeTargets="Build" Condition="'$(HasRecordedFixtures)' != 'true'">
    <Warning Text="Recorded capture fixtures are missing from testdata/recorded; recorded-pull tests are excluded from this build. See docs/TESTING.md." />
  </Target>
</Project>
